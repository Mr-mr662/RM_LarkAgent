# Database configuration
DB_HOST=db
DB_PORT=3306
DB_USER=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=lark_messages

# Lark API configuration
LARK_COOKIE='YOUR LARK Cookie'

# Function trigger flag
FUNCTION_TRIGGER_FLAG="/run"
AUTO_REPLY_PRIVATE="true"
AUTO_REPLY_GROUP="false"
GROUP_TRIGGER_KEYWORDS="@助手,@AI Bot,助手"
CONTEXT_MESSAGE_LIMIT="12"

# AI Bot message prefix (preferably longer)
AI_BOT_PREFIX="Lark AI Bot:"

# OpenAI API configuration
OPENAI_API_KEY="Your api key"
OPENAI_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
OPENAI_API_MODEL="deepseek-r1-250120"
